---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import AttentionLine from '../components/AttentionLine.astro';

const title = 'Nubo Baby Tracker | Fast, Simple Tracking for Shared Care';
const description = 'Fast, simple baby tracking for shared caregiving. Log feeds, sleep, diapers, and more using the device, free app, voice catch-up, and Alexa.';

const amazonURL = 'https://www.amazon.com/nubo-Newborn-Activity-Tracker-Color/dp/B0CJLNBG4P?maas=maas_adg_465D5CB69C73F660B7AD38831E2D680B_afap_abs&ref_=aa_maas&tag=maas';
const appStoreURL = 'https://apps.apple.com/us/app/nubo-baby-tracker/id1667461158';
const playStoreURL = 'https://play.google.com/store/apps/details?id=com.clicksie.nuboapp';
const alexaURL = 'https://www.amazon.com/Clicksie-LLC-Nubo-Baby-Tracker/dp/B0FJ2N8XKB';

const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Product",
      "name": "Nubo Baby Activity Tracker",
      "alternateName": "One-tap baby tracker",
      "description": "The one-tap baby tracker for night feeds, hands-full moments, and multi-caregiver households. Nubo combines a physical device, in-app one-tap and voice logging, an Alexa skill, and a companion app for logging feedings, sleep, and diapers.",
      "image": "https://www.nubotracker.com/images/nubo-instant-tracker.webp",
      "url": "https://www.nubotracker.com/",
      "category": "Baby activity tracker",
      "brand": {
        "@type": "Brand",
        "name": "Nubo",
        "sameAs": [
          "https://www.instagram.com/nubo_baby_tracker",
          "https://www.youtube.com/@NuboBabyTracker"
        ]
      },
      "offers": {
        "@type": "Offer",
        "url": amazonURL,
        "priceCurrency": "USD",
        "price": "89.00",
        "availability": "https://schema.org/InStock"
      }
    },
    {
      "@type": "MobileApplication",
      "name": "Nubo Baby Tracker",
      "operatingSystem": "iOS, Android",
      "applicationCategory": "HealthApplication",
      "description": "Free baby tracker app with one-tap quick logging and on-device voice logging. Track feeds, sleep, diapers, growth (WHO and Fenton), vaccines, allergens, and milestones. Unlimited caregivers, unlimited cloud backup, full offline mode.",
      "image": "https://www.nubotracker.com/images/nubo-instant-tracker.webp",
      "offers": {
        "@type": "Offer",
        "price": "0",
        "priceCurrency": "USD"
      },
      "installUrl": appStoreURL,
      "downloadUrl": [appStoreURL, playStoreURL]
    }
  ]
};
---

<BaseLayout title={title} description={description} jsonLd={jsonLd}>
  <Header />
  <main>

    <!-- ════════════════════════════════════════════
         HERO
    ════════════════════════════════════════════ -->
    <section class="hero">
      <div class="hero-bg"></div>
      <div class="container hero-inner">
        <div class="hero-content">
          <p class="overline">One-tap baby tracker</p>
          <h1>
            Baby tracking
            <span class="hero-accent">made beautifully simple.</span>
          </h1>
          <p class="hero-sub">
            Log feeds, diapers, sleep, and pumping from the free app, one-tap device, voice catch-up, or Alexa, with every caregiver synced to one shared baby timeline.
          </p>
          <div class="hero-actions">
            <a href="/device/" class="btn-primary">
              See screen-free tracker
            </a>
            <a href="/app/#app-downloads" class="btn-ghost">
              Download baby tracker app
            </a>
          </div>
        </div>
        <div class="hero-image">
          <img
            src="/images/hero.webp"
            sizes="(max-width: 768px) 72vw, (max-width: 900px) 88vw, 42vw"
            alt="Nubo baby tracker beside a caregiver holding a newborn"
            width="782"
            height="878"
            loading="eager"
            fetchpriority="high"
            decoding="async"
          />
        </div>
      </div>
    </section>

    <AttentionLine lead="Built to support caregiving, not compete with it." variant="plain" />

    <!-- ════════════════════════════════════════════
         THREE WAYS TO LOG
    ════════════════════════════════════════════ -->
    <section class="three-ways" id="three-ways">
      <div class="container">
        <div class="section-intro reveal">
          <p class="overline">How Nubo works</p>
          <h2 class="nubo-works-headline">
            <span class="sr-only">Track newborn feeds, sleep, and diapers in an instant and carry on with rest.</span>
            <span aria-hidden="true">
              Track newborn feeds, sleep, and diapers in an instant and carry on with
              <span class="benefit-rotator">
                <span class="benefit-rotator-track">
                  <span>rest.</span>
                  <span>baby care.</span>
                  <span>the feed.</span>
                  <span>the nap.</span>
                  <span>the cuddle.</span>
                  <span>soothing.</span>
                  <span>the handoff.</span>
                  <span>being present.</span>
                  <span>rest.</span>
                </span>
              </span>
            </span>
          </h2>
          <p class="section-sub">Log however the moment allows. Everything lands in one timeline that caregivers can trust. Compare the <a href="/app/" class="text-link">free baby tracker app</a>, the <a href="/device/" class="text-link">screen-free baby tracker</a>, or the <a href="/compare/" class="text-link">full setup options</a>.</p>
        </div>

        <div class="ways-grid">
          <div class="way-card reveal">
            <div class="way-card-body">
              <h3>Tap the device</h3>
              <p>Tap the matching button for feeds, sleep, pee, or poop when your phone is locked, across the room, or too bright for 3 a.m.</p>
              <span class="way-best">Best for: night feeds, hands full, phone not nearby</span>
            </div>
          </div>

          <div class="way-card reveal reveal-delay-1">
            <div class="way-card-body">
              <h3>Say it on your phone</h3>
              <p>Remembered later? Say what happened in plain English and Nubo files the structured log at the right time.</p>
              <span class="way-best">Best for: missed logs, fuzzy times, quick catch-up</span>
            </div>
          </div>

          <div class="way-card reveal reveal-delay-2">
            <div class="way-card-body">
              <h3>Tap a card in the app</h3>
              <p>Use colorful quick cards when your phone is already open and you want to log, review, or edit the day.</p>
              <span class="way-best">Best for: app-first tracking, reviewing the day</span>
            </div>
          </div>

          <div class="way-card reveal reveal-delay-2">
            <div class="way-card-body">
              <h3>Ask Alexa</h3>
              <p>Log from across the room when your hands are busy and the phone is not where the care is happening.</p>
              <span class="way-best">Best for: kitchens, nurseries, shared rooms</span>
              <a href="/alexa/" class="text-link">See Alexa logging &rarr;</a>
            </div>
          </div>
        </div>

      </div>
    </section>


    <section class="setup-choice" id="choose">
      <div class="container">
        <div class="section-intro reveal">
          <p class="overline">Choose your setup</p>
          <h2>Start where your routine needs the least explaining.</h2>
          <p class="section-sub">Use this as a quick route into the free baby tracker app, Nubo Plus app tools, or the physical Nubo device.</p>
        </div>
        <div class="setup-grid">
          <article class="setup-card reveal">
            <span class="setup-label">Free app</span>
            <h3>Start tracking today.</h3>
            <p>Best when phone logging already fits your day and you want a shared record on iPhone or Android.</p>
            <a href="/app/#app-downloads" class="btn-primary">Download free app</a>
          </article>
          <article class="setup-card reveal reveal-delay-1">
            <span class="setup-label">Nubo Plus</span>
            <h3>Add advanced app tools.</h3>
            <p>Best when your app workflow needs exports, reminders, Alexa, private pumping, or deeper views.</p>
            <a href="/pricing/#plans" class="btn-ghost">Compare Nubo Plus</a>
          </article>
          <article class="setup-card setup-card-device reveal reveal-delay-2">
            <span class="setup-label">Nubo device</span>
            <h3>One tap, easy to remember.</h3>
            <p>Best when night feeds, helpers, or hands-full moments make opening a phone feel like too much.</p>
            <a href={amazonURL} class="btn-primary" target="_blank" rel="noopener noreferrer">Buy device</a>
          </article>
        </div>

        <p class="section-route reveal"><a href="/compare/" class="text-link">Compare setup options &rarr;</a></p>
      </div>
      
    </section>


    <!-- ════════════════════════════════════════════
         CAREGIVERS
    ════════════════════════════════════════════ -->
    <section class="caregivers" id="caregivers">
      <div class="container">
        <div class="section-intro reveal">
          <p class="overline">Nubo for Everyone</p>
          <h2>Baby tracker for caregivers.<br/>Always free.</h2>
          <p class="section-sub">Invite a partner, grandparent, nanny, or family helper with a QR code. Everyone sees the same encrypted timeline across iOS and Android.</p>
        </div>

        <div class="caregivers-banner reveal">
          <img src="/images/caregiver-hub.webp" sizes="(max-width: 768px) 92vw, 970px" alt="Nubo device syncing baby tracking data with multiple caregiver phones" width="970" height="600" loading="lazy" decoding="async"/>
        </div>
        <p class="section-route reveal"><a href="/caregivers/" class="text-link">See caregiver sync &rarr;</a></p>
      </div>
    </section>


    <!-- ════════════════════════════════════════════
         PRIVACY
    ════════════════════════════════════════════ -->
    <section class="privacy" id="privacy">
      <div class="container privacy-inner">
        <div class="privacy-text reveal">
          <p class="overline">Built for Your Privacy</p>
          <h2>Your baby's data<br/>stays yours.</h2>
          <ul class="privacy-list">
            <li>No ads and no selling baby data.</li>
            <li>In-app voice catch-up runs on your phone.</li>
            <li>Backups use your iCloud or Google Drive.</li>
            <li>Caregiver sharing is encrypted between invited people.</li>
          </ul>
          <a href="/privacy/" class="text-link">Read the privacy overview &rarr;</a>
        </div>
        <div class="privacy-visual reveal reveal-delay-1">
          <img src="/images/privacy-shield.webp" alt="Nubo app interface showing privacy-first data widgets and encrypted sharing" width="600" height="405" />
        </div>
      </div>
    </section>

    <!-- ════════════════════════════════════════════
         FINAL CTA
    ════════════════════════════════════════════ -->
    <section class="final-cta" id="buy">
      <div class="container final-cta-inner reveal">
        <h2>Track baby feeding, sleep, diapers, and handoffs with confidence.</h2>
        <p class="final-sub">Whether your baby is almost here or already in your arms, make feeds, sleep, diapers, and handoffs easier to review when the next tired shift begins.</p>

        <div class="final-actions">
          <a href="/app/#app-downloads" class="btn-primary btn-lg">Download free app</a>
          <a href={amazonURL} class="btn-ghost btn-lg" target="_blank" rel="noopener noreferrer">Buy device</a>
          <a href="/pricing/" class="text-link">Compare setups &rarr;</a>
        </div>

        <div class="final-trust-badges">
          <span class="trust-badge">
            <span class="trust-badge-icon">✓</span>
            Private by design
          </span>
          <span class="trust-badge">
            <span class="trust-badge-icon">✓</span>
            Caregivers stay in sync
          </span>
          <span class="trust-badge">
            <span class="trust-badge-icon">✓</span>
            Less phone at 3 a.m.
          </span>
        </div>

        <div class="store-badges">
          <p class="store-label">Get the free Nubo app and Alexa skill</p>
          <div class="store-links">
            <a href={appStoreURL} target="_blank" rel="noopener noreferrer">
              <img src="/images/appstore-badge.webp" alt="Download on the App Store" width="160" height="56" />
            </a>
            <a href={playStoreURL} target="_blank" rel="noopener noreferrer">
              <img src="/images/playstore-badge.webp" alt="Get it on Google Play" width="160" height="56" />
            </a>
            <a href={alexaURL} target="_blank" rel="noopener noreferrer" class="alexa-badge-link">
              <img src="/images/just-ask-alexa-badge.webp" alt="Just Ask Alexa" width="250" height="122" />
            </a>
          </div>
        </div>
      </div>
    </section>

  </main>
  <Footer />
</BaseLayout>

<style>
  /* ═══════════════════════════════════════════
     HERO
  ═══════════════════════════════════════════ */
  .hero {
    position: relative;
    display: flex;
    align-items: center;
    padding: 0;
    overflow: hidden;
  }

  .hero-bg {
    position: absolute;
    inset: 0;
    z-index: 0;
    background: var(--color-bg-ivory);
  }

  .hero-inner {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: 1.05fr 0.95fr;
    align-items: center;
    gap: 3rem;
    padding-top: calc(72px + 3.75rem);
    padding-bottom: 3.75rem;
  }

  .hero-content h1 {
    font-size: clamp(2.25rem, 4.5vw, 3.25rem);
    font-weight: 700;
    line-height: 1.12;
    letter-spacing: 0;
    color: var(--color-text);
  }

  .hero-accent {
    color: var(--color-brand);
  }

  .hero-sub {
    margin-top: 1.5rem;
    font-size: 1.125rem;
    color: var(--color-text-secondary);
    font-weight: 500;
    line-height: 1.7;
    max-width: 460px;
  }

  .hero-actions {
    margin-top: 2rem;
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .hero-image {
    position: relative;
    display: flex;
    justify-content: center;
    align-items: center;
  }

  .hero-image::before {
    content: "";
    position: absolute;
    inset: 6% 0 5% 6%;
    z-index: -1;
    border-radius: 48% 42% 46% 38%;
    background: var(--color-bg-peach);
  }

  .hero-image img {
    width: min(100%, 560px);
    max-height: min(80vh, 650px);
    object-fit: contain;
    border-radius: var(--radius-xl);
    filter: drop-shadow(0 20px 42px rgba(90, 55, 42, 0.12));
  }

  :global(.hero + .attention-line) {
    padding-top: 0;
    padding-bottom: 3.5rem;
    background: var(--color-bg-ivory);
  }

  @media (max-width: 768px) {
    .hero {
      min-height: auto;
      padding: 0;
    }
    .hero-inner {
      grid-template-columns: 1fr;
      text-align: center;
      gap: 1.25rem;
      padding-top: 88px;
      padding-bottom: 2.5rem;
      min-height: auto;
    }
    .hero-content h1 { font-size: clamp(2rem, 10vw, 2.65rem); }
    .hero-accent { display: block; }
    .hero-sub { margin: 1rem auto 0; font-size: 1rem; line-height: 1.65; }
    .hero-actions { justify-content: center; }
    .hero-image { order: -1; }
    .hero-image::before { inset: 8% 8% 4%; }
    .hero-image img { max-height: 29vh; max-width: 76vw; }
  }


  .setup-choice {
    padding: 6rem 0;
    background: var(--color-bg-soft);
  }

  .setup-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.5rem;
  }

  .setup-card {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    padding: 1.75rem;
    border: 1px solid #e8e8e8;
    border-radius: var(--radius-xl);
    background: #fff;
  }

  .setup-card-device {
    border: 2px solid #1d1d1f;
    box-shadow: 0 14px 38px rgba(0, 0, 0, 0.08);
  }

  .setup-label {
    align-self: flex-start;
    padding: 0.375rem 0.75rem;
    border-radius: 999px;
    background: var(--color-brand-light);
    color: var(--color-brand-dark);
    font-size: 0.75rem;
    font-weight: 800;
    text-transform: uppercase;
  }

  .setup-card-device .setup-label {
    background: #1d1d1f;
    color: #fff;
  }

  .setup-card h3 {
    font-size: 1.25rem;
    line-height: 1.2;
  }

  .setup-card p {
    color: var(--color-text-secondary);
    line-height: 1.65;
    flex: 1;
  }

  .setup-card .btn-primary,
  .setup-card .btn-ghost {
    width: 100%;
  }


  /* ═══════════════════════════════════════════
     THREE WAYS TO LOG
  ═══════════════════════════════════════════ */
  .three-ways {
    padding: 8rem 0;
    background: var(--color-bg-warm);
  }

  .three-ways h2 {
    font-size: clamp(2rem, 5vw, 3.5rem);
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  .nubo-works-headline {
    max-width: 900px;
    margin-left: auto;
    margin-right: auto;
    line-height: 1.08;
  }

  .benefit-rotator {
    display: inline-grid;
    min-width: 8.5ch;
    height: 1.08em;
    overflow: hidden;
    color: var(--color-brand);
    vertical-align: bottom;
    text-align: left;
  }

  .benefit-rotator-track {
    display: grid;
    animation: rotateBenefit 18s cubic-bezier(0.76, 0, 0.24, 1) infinite;
  }

  .benefit-rotator-track span {
    height: 1.08em;
    line-height: 1.08;
  }

  @keyframes rotateBenefit {
    0%, 8% { transform: translateY(0); }
    11%, 19% { transform: translateY(-1.08em); }
    22%, 30% { transform: translateY(-2.16em); }
    33%, 41% { transform: translateY(-3.24em); }
    44%, 52% { transform: translateY(-4.32em); }
    55%, 63% { transform: translateY(-5.4em); }
    66%, 74% { transform: translateY(-6.48em); }
    77%, 85% { transform: translateY(-7.56em); }
    88%, 100% { transform: translateY(-8.64em); }
  }

  .three-ways .section-sub {
    max-width: 720px;
  }

  .ways-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1.5rem;
  }

  .way-card {
    background: #fff;
    border-radius: var(--radius-xl);
    display: flex;
    text-align: center;
    transition: transform 0.4s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .way-card:hover {
    transform: translateY(-4px);
  }

  .way-card-body {
    width: 100%;
    padding: 2.5rem 2rem;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .way-card h3 {
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--color-text);
    margin-bottom: 0.75rem;
    letter-spacing: 0;
  }

  .way-card p {
    font-size: 0.9375rem;
    color: var(--color-text-secondary);
    line-height: 1.65;
    margin-bottom: 1.25rem;
    flex: 1;
  }

  .way-best {
    display: block;
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--color-brand-dark);
    background: var(--color-brand-light);
    padding: 0.5rem 1rem;
    border-radius: 100px;
  }

  .ways-convergence {
    text-align: center;
    margin-top: 3rem;
    font-size: 1.0625rem;
    font-weight: 600;
    color: var(--color-text);
  }

  .section-route {
    margin-top: 1rem;
    text-align: center;
  }

  @media (max-width: 1080px) {
    .ways-grid { grid-template-columns: repeat(2, 1fr); }
  }

  @media (max-width: 768px) {
    .three-ways { padding: 5rem 0; }
    .benefit-rotator {
      display: grid;
      min-width: 100%;
      margin-top: 0.1em;
      text-align: center;
    }
    .ways-grid { grid-template-columns: 1fr; }
  }

  @media (prefers-reduced-motion: reduce) {
    .benefit-rotator {
      display: inline;
      height: auto;
      min-width: 0;
      overflow: visible;
      vertical-align: baseline;
    }

    .benefit-rotator-track {
      display: inline;
      animation: none;
    }

    .benefit-rotator-track span {
      display: none;
    }

    .benefit-rotator-track span:first-child {
      display: inline;
    }
  }


  /* ═══════════════════════════════════════════
     CAREGIVERS
  ═══════════════════════════════════════════ */
  .caregivers {
    padding: 8rem 0;
    background: var(--color-bg-warm);
  }

  .caregivers h2 {
    font-size: clamp(2rem, 5vw, 3.5rem);
  }

  .caregivers-banner {
    background: transparent;
  }

  .caregivers-banner img {
    width: 100%;
    height: auto;
    display: block;
  }

  @media (max-width: 768px) {
    .caregivers { padding: 5rem 0; }
  }


  /* ═══════════════════════════════════════════
     PRIVACY
  ═══════════════════════════════════════════ */
  .privacy {
    padding: 8rem 0;
    background: var(--color-bg-soft);
  }

  .privacy-inner {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 4rem;
    align-items: center;
  }

  .privacy-text h2 {
    font-size: clamp(1.75rem, 4vw, 3rem);
    font-weight: 700;
    line-height: 1.12;
    letter-spacing: 0;
    color: var(--color-text);
    margin-bottom: 1.5rem;
  }

  .privacy-list {
    display: grid;
    gap: 0.75rem;
    list-style: none;
    margin-bottom: 1.5rem;
  }

  .privacy-list li {
    position: relative;
    padding-left: 1.5rem;
    color: #444;
    font-size: 1rem;
    line-height: 1.55;
  }

  .privacy-list li::before {
    content: "✓";
    position: absolute;
    left: 0;
    color: var(--color-brand);
    font-weight: 800;
  }

  .privacy-visual img {
    width: 100%;
    max-width: 300px;
    margin: 0 auto;
    display: block;
    border-radius: var(--radius-xl);
  }

  @media (max-width: 768px) {
    .privacy { padding: 5rem 0; }
    .privacy-inner { grid-template-columns: 1fr; gap: 2rem; }
    .privacy-visual { order: -1; }
  }


  /* ═══════════════════════════════════════════
     FINAL CTA
  ═══════════════════════════════════════════ */
  .final-cta {
    padding: 8rem 0;
    background: var(--color-bg-warm);
    text-align: center;
  }

  .final-cta-inner h2 {
    font-size: clamp(2.5rem, 6vw, 4.5rem);
    font-weight: 700;
    line-height: 1.05;
    letter-spacing: 0;
    color: var(--color-text);
    margin-bottom: 1rem;
  }

  .final-sub {
    font-size: 1.0625rem;
    color: var(--color-text-secondary);
    line-height: 1.7;
    max-width: 760px;
    margin: 0 auto 2.5rem;
  }

  .final-price-frame {
    font-size: clamp(1.125rem, 2.5vw, 1.5rem);
    font-weight: 600;
    color: var(--color-brand);
