---
interface Props {
  title: string;
  description: string;
  canonicalURL?: string;
  ogImage?: string;
  ogType?: string;
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
}

import MobileStickyCTA from '../components/MobileStickyCTA.astro';

const {
  title,
  description,
  canonicalURL = Astro.url.href,
  ogImage = '/images/nubo-instant-tracker.webp',
  ogType = 'website',
  jsonLd,
} = Astro.props;

const siteName = 'Nubo Baby Tracker';
const stickyCtaVariant = ['/device/','/gift/'].includes(Astro.url.pathname) ? 'device' : 'app';
const siteURL = 'https://www.nubotracker.com';

const absoluteURL = (url: string) => new URL(url, siteURL).href;
const canonicalHref = absoluteURL(canonicalURL);
const ogImageHref = absoluteURL(ogImage);

const labelOverrides: Record<string, string> = {
  alexa: 'Alexa Skill',
  app: 'App',
  blog: 'Blog',
  caregivers: 'Caregivers',
  compare: 'Compare',
  contact: 'Contact',
  device: 'Device',
  faq: 'FAQ',
  gift: 'Gift',
  guides: 'Guides',
  resources: 'Resources',
  pricing: 'Pricing',
  privacy: 'Privacy',
  'privacy-policy': 'Privacy Policy',
  support: 'Support',
  'terms-of-use': 'Terms of Use',
  tracking: 'Tracking',
};

const titleCase = (segment: string) =>
  labelOverrides[segment] ||
  segment
    .split('-')
    .map((word) => word.charAt(0).toUpperCase() + word.slice(1))
    .join(' ');

const pathSegments = Astro.url.pathname.split('/').filter(Boolean);
let breadcrumbPath = '';
const breadcrumbList = {
  '@type': 'BreadcrumbList',
  itemListElement: [
    {
      '@type': 'ListItem',
      position: 1,
      name: 'Home',
      item: siteURL + '/',
    },
    ...pathSegments.map((segment, index) => {
      breadcrumbPath += `/${segment}/`;
      return {
        '@type': 'ListItem',
        position: index + 2,
        name: titleCase(segment),
        item: absoluteURL(breadcrumbPath),
      };
    }),
  ],
};

const jsonLdItems = Array.isArray(jsonLd)
  ? jsonLd
  : jsonLd && Array.isArray(jsonLd['@graph'])
    ? (jsonLd['@graph'] as Record<string, unknown>[])
    : jsonLd
      ? [jsonLd]
      : [];

const jsonLdGraph = {
  '@context': 'https://schema.org',
  '@graph': [...jsonLdItems.map(({ '@context': _context, ...item }) => item), breadcrumbList],
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/png" href="/favicon-32.png" sizes="32x32" />
    <link rel="icon" type="image/png" href="/favicon-192.png" sizes="192x192" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <!-- SEO -->
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalHref} />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <!-- Preload LCP image on the home page -->
    {Astro.url.pathname === '/' && (
      <link rel="preload" as="image" href="/images/nubo-instant-tracker-640.webp" imagesrcset="/images/nubo-instant-tracker-640.webp 640w, /images/nubo-instant-tracker-900.webp 900w, /images/nubo-instant-tracker-1400.webp 1400w" imagesizes="(max-width: 768px) 72vw, (max-width: 900px) 88vw, 48vw" fetchpriority="high" />
    )}

    <!-- Open Graph -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalHref} />
    <meta property="og:image" content={ogImageHref} />
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={siteName} />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageHref} />

    <!-- JSON-LD -->
    <script type="application/ld+json" set:html={JSON.stringify(jsonLdGraph)} />

    <!-- Privacy-friendly analytics by Plausible -->
    <script is:inline async src="https://plausible.io/js/pa-JoZ6LWPbsMH48HXPxzh_Z.js"></script>
    <script is:inline>
      window.plausible=window.plausible||function(){(plausible.q=plausible.q||[]).push(arguments)},plausible.init=plausible.init||function(i){plausible.o=i||{}};
      plausible.init()
    </script>
    <script is:inline>
      document.addEventListener('click', (event) => {
        const link = event.target instanceof Element ? event.target.closest('a') : null;
        if (!link || typeof plausible !== 'function') return;

        const href = link.getAttribute('href') || '';
        const label = link.textContent?.trim().replace(/\s+/g, ' ').slice(0, 80) || 'Unlabeled link';
        let action = '';

        if (href.includes('apps.apple.com')) action = 'App Store Click';
        else if (href.includes('play.google.com')) action = 'Google Play Click';
        else if (href.includes('amazon.com') && href.includes('B0CJLNBG4P')) action = 'Amazon Device Click';
        else if (href.includes('/app/#app-downloads') || href === '#app-downloads') action = 'Download Intent Click';
        else if (href.includes('/pricing/') || href.includes('/compare/')) action = 'Decision Support Click';

        if (!action) return;
        plausible(action, { props: { label, href, path: window.location.pathname } });
      }, { capture: true });
    </script>

    <!-- Fonts – self-hosted to eliminate the Google Fonts critical chain -->
    <link
      rel="preload"
      as="font"
      type="font/woff2"
      href="/fonts/quicksand-latin.woff2"
      crossorigin
    />
  </head>
  <body>
    <slot />
    <MobileStickyCTA variant={stickyCtaVariant} />
    <script>
      const scrollToHashTarget = () => {
        if (!window.location.hash) return false;
        const target = document.getElementById(decodeURIComponent(window.location.hash.slice(1)));
        if (!target) return true;
        target.scrollIntoView({ block: 'start' });
        return true;
      };

      if ('scrollRestoration' in history) {
        history.scrollRestoration = 'manual';
      }
      window.addEventListener('pageshow', () => {
        if (scrollToHashTarget()) {
          setTimeout(scrollToHashTarget, 300);
          setTimeout(scrollToHashTarget, 1000);
          return;
        }
        requestAnimationFrame(() => window.scrollTo(0, 0));
      });
      window.addEventListener('load', () => {
        if (scrollToHashTarget()) setTimeout(scrollToHashTarget, 300);
      }, { once: true });
    </script>
  </body>
</html>

<style is:global>  /* ── Self-hosted Quicksand ── */
  @font-face {
    font-family: 'Quicksand';
    font-style: normal;
    font-weight: 400 700;
    font-display: swap;
    src: url('/fonts/quicksand-latin.woff2') format('woff2');
    unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD;
  }
  @font-face {
    font-family: 'Quicksand';
    font-style: normal;
    font-weight: 400 700;
    font-display: swap;
    src: url('/fonts/quicksand-latin-ext.woff2') format('woff2');
    unicode-range: U+0100-02BA, U+02BD-02C5, U+02C7-02CC, U+02CE-02D7, U+02DD-02FF, U+0304, U+0308, U+0329, U+1D00-1DBF, U+1E00-1E9F, U+1EF2-1EFF, U+2020, U+20A0-20AB, U+20AD-20C0, U+2113, U+2C60-2C7F, U+A720-A7FF;
  }
  @font-face {
    font-family: 'Quicksand';
    font-style: normal;
    font-weight: 400 700;
    font-display: swap;
    src: url('/fonts/quicksand-vietnamese.woff2') format('woff2');
    unicode-range: U+0102-0103, U+0110-0111, U+0128-0129, U+0168-0169, U+01A0-01A1, U+01AF-01B0, U+0300-0301, U+0303-0304, U+0308-0309, U+0323, U+0329, U+1EA0-1EF9, U+20AB;
  }
  /* ── Reset ─────────────────────────── */
  *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

  /* Fallback font tuned to match Quicksand metrics, preventing CLS on font swap */
  @font-face {
    font-family: 'Quicksand Fallback';
    src: local('Arial');
    size-adjust: 96%;
    ascent-override: 95%;
    descent-override: 24%;
    line-gap-override: 0%;
  }

  html {
    font-family: 'Quicksand', 'Quicksand Fallback', system-ui, -apple-system, sans-serif;
    scroll-behavior: smooth;
    -webkit-font-smoothing: antialiased;
    text-rendering: optimizeLegibility;
  }

  body {
    color: #1d1d1f;
    background: #ffffff;
    font-weight: 500;
    line-height: 1.6;
    overflow-x: hidden;
  }

  img { max-width: 100%; height: auto; display: block; }
  a { color: inherit; text-decoration: none; }
  button { cursor: pointer; font: inherit; }

  /* ── Container ─────────────────────── */
  .container {
    width: 100%;
    max-width: 1120px;
    margin: 0 auto;
    padding: 0 2rem;
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0,0,0,0);
    white-space: nowrap;
    border: 0;
  }

  /* ── Design tokens ─────────────────── */
  :root {
    --color-brand: #087f84;
    --color-brand-dark: #066a70;
    --color-brand-light: #e6f9fa;
    --color-text: #1d1d1f;
    --color-text-secondary: #4f5358;
    --color-bg-warm: #faf8f5;
    --color-bg-soft: #f5f5f7;
    --radius-xl: 24px;
    --radius-2xl: 32px;
  }

  /* ── Shared UI classes ─────────────── */
  .overline {
    font-size: 0.8125rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-brand);
    margin-bottom: 0.75rem;
  }

  .section-intro {
    text-align: center;
    margin-bottom: 4rem;
  }

  .section-intro h2 {
    font-size: clamp(2rem, 5vw, 3.5rem);
    font-weight: 700;
    line-height: 1.1;
    letter-spacing: 0;
    color: var(--color-text);
  }

  .section-sub {
    font-size: 1.125rem;
    color: var(--color-text-secondary);
    font-weight: 500;
    max-width: 540px;
    margin: 1rem auto 0;
    line-height: 1.6;
  }

  .btn-primary {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 1rem 2.25rem;
    font-size: 1rem;
    font-weight: 700;
    color: #fff;
    background: var(--color-brand);
    border-radius: 100px;
    border: none;
    transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
    letter-spacing: 0;
  }

  .btn-primary:hover {
    background: var(--color-brand-dark);
    transform: scale(1.04);
    box-shadow: 0 8px 30px rgba(19, 188, 195, 0.3);
  }

  .btn-ghost {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 1rem 2.25rem;
    font-size: 1rem;
    font-weight: 700;
    color: var(--color-brand);
    background: transparent;
    border: 2px solid var(--color-brand);
    border-radius: 100px;
    transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .btn-ghost:hover {
    background: var(--color-brand-light);
  }

  .btn-lg {
    padding: 1.125rem 3rem;
    font-size: 1.125rem;
  }

  .text-link {
    font-size: 0.9375rem;
    font-weight: 700;
    color: var(--color-brand);
    transition: color 0.2s;
  }

  .text-link:hover {
    color: var(--color-brand-dark);
  }

  /* ── Page hero (shared by inner pages) ── */
  .page-hero {
    padding: 10rem 0 4rem;
    background: linear-gradient(170deg, #f0fafa 0%, #fff 60%);
    text-align: center;
  }

  .page-hero h1 {
    font-size: clamp(2.5rem, 5vw, 4rem);
    font-weight: 700;
    line-height: 1.1;
    letter-spacing: 0;
    color: var(--color-text);
  }

  .page-hero-sub {
    margin-top: 1rem;
    font-size: 1.125rem;
    color: var(--color-text-secondary);
    font-weight: 500;
    max-width: 520px;
    margin-left: auto;
    margin-right: auto;
    line-height: 1.7;
  }

  .hero-link {
    color: var(--color-brand);
    font-weight: 700;
    transition: color 0.2s;
  }

  .hero-link:hover {
    color: var(--color-brand-dark);
  }
</style>
